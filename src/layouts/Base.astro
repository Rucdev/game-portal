---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">game-portal</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f5f1;
    --surface: #ffffff;
    --ink: #1c1b19;
    --muted: #6b6860;
    --line: #dddad2;
    --accent: #1f6f5c;
    --accent-ink: #ffffff;
    --danger: #a3341f;
    --warn: #8a6100;
    --radius: 8px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151614;
      --surface: #1e201d;
      --ink: #ecebe6;
      --muted: #a09d94;
      --line: #33352f;
      --accent: #58b79f;
      --accent-ink: #0d1512;
      --danger: #e2826d;
      --warn: #d9a93a;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family:
      system-ui,
      -apple-system,
      'Hiragino Sans',
      'Noto Sans JP',
      sans-serif;
    line-height: 1.6;
  }
  a {
    color: var(--accent);
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .site-header .brand {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
  }
</style>
