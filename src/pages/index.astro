---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import { SITE_NAME, SITE_TAGLINE } from '../site';

export const prerender = false;

const { results: games } = await env.DB.prepare(
  'SELECT slug, title FROM games WHERE active_version IS NOT NULL ORDER BY created_at DESC',
).all<{ slug: string; title: string }>();
---

<Base>
  <section class="hero">
    <h1>{SITE_NAME}</h1>
    <p>{SITE_TAGLINE}</p>
  </section>
  <h2>ゲーム</h2>
  {
    games.length === 0 ? (
      <p class="empty">公開中のゲームはまだありません。</p>
    ) : (
      <ul class="games">
        {games.map((game) => (
          <li>
            <a href={`/play/${game.slug}`}>{game.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .hero {
    margin: 1rem 0 2rem;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.2;
  }
  .hero p {
    margin: 0.4rem 0 0;
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
  }
  .games {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .games a {
    display: block;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .games a:hover {
    border-color: var(--accent);
  }
</style>
